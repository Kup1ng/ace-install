#!/usr/bin/env bash
# The Ace panel's host command (v2), installed by install.sh as
# /usr/local/bin/ace. Run "ace help" for its commands.
#
# An upgrade runs the target version's own copy of this script (its
# __upgrade command), so each version brings the steps it needs, its
# Caddyfile included. Before it changes anything it backs up the database to
# /opt/ace/backups (the last 3 stay), and it goes back by itself when the
# new version is not healthy within 3 minutes. Going back never touches the
# data: the panel's migrations only expand the schema until a later version
# contracts it. v2 starts on a fresh install: a 1.x panel is never upgraded
# to 2.x, and a 2.x panel never goes back to 1.x.
set -euo pipefail

dir=/opt/ace
repo_raw=https://raw.githubusercontent.com/Kup1ng/ace-install
health_wait=60 # checks, 3 s apart: 3 minutes
first_major=2  # this line's major version
hsts_default=86400 # 1 day, no preload, until the owner settles the certificate plan (Plan §5.7)

say() { printf '\033[1;32m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mwarning:\033[0m %s\n' "$*" >&2; }
die() {
  printf '\033[1;31merror:\033[0m %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: ace <command>

  status                   the panel's containers, its version and address
  logs [service...]        follow the logs, e.g. ace logs panel-api
  version                  the installed version
  restart [service]        restart the panel, or one of its services
  apply                    apply a change to .env: writes the Caddyfile again
                           and recreates only the services that changed
  certificate <cert> <key> use your own HTTPS certificate (PEM files: the
                           certificate with its chain, and its key): checks
                           them, copies them to /opt/ace/tls, sets ACE_TLS=custom
                           and restarts Caddy; run it again to renew
  upgrade <version>        back up the database, move the panel to <version>,
                           and go back by itself if it is not healthy in 3 minutes
  rollback                 go back to the version before the last upgrade; the
                           data stays as it is
  help                     this help

The panel lives in /opt/ace: compose.yml, .env (version, domain, HTTPS),
Caddyfile (written from .env), tls/ (your own certificate), secrets/ (never
shown) and backups/ (before each upgrade).
EOF
}

compose() { docker compose -f "$dir/compose.yml" "$@"; }

# setting NAME [FILE] prints a value of /opt/ace/.env, or of FILE.
setting() { sed -n "s/^$1=//p" "${2:-$dir/.env}" 2>/dev/null | tail -1; }

# set_setting NAME VALUE writes a value of /opt/ace/.env in one move.
set_setting() {
  local next
  next="$(mktemp "$dir/.env.XXXXXX")"
  grep -v "^$1=" "$dir/.env" >"$next" || true
  printf '%s=%s\n' "$1" "$2" >>"$next"
  chmod 600 "$next"
  mv "$next" "$dir/.env"
}

# major VERSION prints a version's major number: 2 for 2.0.0-rc.1.
major() { printf '%s' "${1%%.*}"; }

# fetch VERSION NAME DEST downloads one of ace-install's files of a version,
# through ACE_PROXY when .env has one. curl reads the proxy from its
# environment, which only root can see: on its command line (-x) every user
# of the server could read the proxy's password.
fetch() {
  local proxy opts=(-fsSL --retry 3 --connect-timeout 15 "${repo_raw}/${ACE_INSTALL_REF:-v$1}/$2" -o "$3")
  proxy="$(setting ACE_PROXY)"
  if [[ -n "$proxy" ]]; then
    https_proxy="$proxy" HTTPS_PROXY="$proxy" curl "${opts[@]}"
  else
    curl "${opts[@]}"
  fi
}

# healthy VERSION waits up to 3 minutes for the panel to answer its health
# check as VERSION.
healthy() {
  local body
  for _ in $(seq 1 "$health_wait"); do
    body="$(compose exec -T panel-api wget -qO- http://127.0.0.1:8080/api/v1/health 2>/dev/null </dev/null || true)"
    if [[ "$body" == *'"status":"ok"'* && "$body" == *"\"version\":\"$1\""* ]]; then
      return 0
    fi
    sleep 3
  done
  return 1
}

start() { compose up -d --remove-orphans </dev/null; }

# caddyfile prints the production Caddyfile for the settings in .env
# (Plan §16): one origin for the web app and the API; HSTS with a low
# max-age and no preload, nosniff, Referrer-Policy and Permissions-Policy on
# every answer, and a deny-all CSP on /api (HTML gets its CSP with a
# per-request nonce from the web app). ACE_TLS=custom serves the owner's
# certificate from /opt/ace/tls; acme lets Caddy get and renew one.
caddyfile() {
  local domain email tls hsts
  domain="$(setting ACE_DOMAIN)"
  email="$(setting ACE_EMAIL)"
  tls="$(setting ACE_TLS)"
  hsts="$(setting ACE_HSTS_MAX_AGE)"
  hsts="${hsts:-$hsts_default}"
  [[ "$domain" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]] || die "ACE_DOMAIN in ${dir}/.env is not a domain name"
  [[ "$hsts" =~ ^[0-9]{1,9}$ ]] || die "ACE_HSTS_MAX_AGE in ${dir}/.env must be a number of seconds"
  [[ -z "$email" || "$email" =~ ^[^[:space:]@\"{}]+@[^[:space:]@\"{}]+$ ]] || die "ACE_EMAIL in ${dir}/.env is not an email address"
  printf '# The Ace panel: one origin for the web app and the API. Written by the\n'
  printf '# ace command from %s/.env: change .env and run "ace apply" instead of editing it.\n{\n' "$dir"
  [[ -z "$email" || "${tls:-acme}" != acme ]] || printf '\temail %s\n' "$email"
  # An upload that stalls (a plugin bundle of 80 MB on a slow line) gets 5
  # minutes before Caddy gives up, instead of 1.
  printf '\tservers {\n\t\ttimeouts {\n\t\t\tread_body_idle 5m\n\t\t}\n\t}\n}\n\n'
  printf '%s {\n' "$domain"
  case "${tls:-acme}" in
  acme) ;;
  custom) printf '\ttls /etc/caddy/tls/cert.pem /etc/caddy/tls/key.pem\n' ;;
  *) die "ACE_TLS in ${dir}/.env must be acme or custom" ;;
  esac
  cat <<EOF
	encode zstd gzip

	# Every answer (Plan §16). HSTS starts low and without preload, so an
	# expired certificate during a long cut never locks browsers out for good.
	header {
		Strict-Transport-Security "max-age=${hsts}"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}

	handle /api/* {
		# The API answers JSON and files, never a page: nothing may run or frame it.
		header {
			Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
			defer
		}
		reverse_proxy panel-api:8080
	}

	handle {
		reverse_proxy panel-web:3000
	}
}
EOF
}

# render_caddyfile DEST writes the Caddyfile to DEST, or removes DEST and
# exits when .env holds a bad value.
render_caddyfile() {
  if ! (caddyfile) >"$1"; then
    rm -f "$1"
    exit 1
  fi
}

# write_caddyfile writes /opt/ace/Caddyfile from .env in one move, and sets
# caddy_changed to 1 when its content changed.
write_caddyfile() {
  local next
  caddy_changed=0
  next="$(mktemp "$dir/Caddyfile.XXXXXX")"
  render_caddyfile "$next"
  if cmp -s "$next" "$dir/Caddyfile"; then
    rm -f "$next"
    return 0
  fi
  chmod 644 "$next"
  mv "$next" "$dir/Caddyfile"
  caddy_changed=1
}

# check_cert CERT KEY DOMAIN checks an owner's certificate: PEM files, the
# key belongs to the certificate, it names DOMAIN and has not expired. It
# warns when it expires within 21 days.
check_cert() {
  local cert="$1" key="$2" domain="$3"
  command -v openssl >/dev/null || die "openssl is needed to check the certificate"
  [[ -r "$cert" && -r "$key" ]] || die "cannot read ${cert} and ${key}"
  openssl x509 -in "$cert" -noout 2>/dev/null || die "${cert} is not a PEM certificate"
  openssl pkey -in "$key" -noout 2>/dev/null || die "${key} is not a PEM private key without a passphrase"
  [[ "$(openssl x509 -in "$cert" -noout -pubkey)" == "$(openssl pkey -in "$key" -pubout)" ]] ||
    die "the key ${key} does not belong to the certificate ${cert}"
  [[ "$(openssl x509 -in "$cert" -noout -checkhost "$domain" 2>/dev/null)" == *"does match"* ]] ||
    die "the certificate ${cert} does not name ${domain}"
  openssl x509 -in "$cert" -noout -checkend 0 >/dev/null || die "the certificate ${cert} has expired"
  openssl x509 -in "$cert" -noout -checkend $((21 * 86400)) >/dev/null ||
    warn "the certificate expires within 21 days ($(openssl x509 -in "$cert" -noout -enddate | cut -d= -f2)); renew it soon"
}

# tls_files CERT KEY checks an owner's certificate and copies it to
# /opt/ace/tls, which Caddy reads: the certificate for everyone, the key for
# root only.
tls_files() {
  [[ $# -eq 2 ]] || die "usage: ace certificate <certificate.pem> <key.pem>"
  check_cert "$1" "$2" "$(setting ACE_DOMAIN)"
  install -d -m 755 "$dir/tls"
  install -m 644 "$1" "$dir/tls/cert.pem.new"
  install -m 600 "$2" "$dir/tls/key.pem.new"
  mv "$dir/tls/cert.pem.new" "$dir/tls/cert.pem"
  mv "$dir/tls/key.pem.new" "$dir/tls/key.pem"
}

# certificate CERT KEY switches the panel to the owner's certificate, or
# renews it, and restarts Caddy with it.
certificate() {
  tls_files "$@"
  set_setting ACE_TLS custom
  write_caddyfile
  compose up -d --force-recreate --no-deps caddy </dev/null || die "Caddy did not start with the certificate (see: ace logs caddy)"
  say "Caddy serves your certificate for $(setting ACE_DOMAIN); it expires $(openssl x509 -in "$dir/tls/cert.pem" -noout -enddate | cut -d= -f2)"
}

apply() {
  write_caddyfile
  start
  if [[ "$caddy_changed" == 1 ]]; then
    compose up -d --force-recreate --no-deps caddy </dev/null
  fi
  say "applied ${dir}/.env"
}

# restore puts back the files of the version before the upgrade.
restore() {
  cp -p "$dir/rollback/compose.yml" "$dir/rollback/.env" "$dir/"
  [[ ! -f "$dir/rollback/Caddyfile" ]] || cp -p "$dir/rollback/Caddyfile" "$dir/"
}

# backup FROM TO dumps the panel's database into
# /opt/ace/backups/<time>-<from>-to-<to>/, for root only, and keeps the
# last 3 such backups (D29).
backup() {
  backup_dir="$dir/backups/$(date -u +%Y%m%d-%H%M%S)-$1-to-$2"
  install -d -m 700 "$dir/backups" "$backup_dir"
  say "Backing up the database to ${backup_dir}"
  compose exec -T postgres pg_dump -U ace -d ace -Fc </dev/null >"$backup_dir/ace.pgdump" ||
    die "backing up the panel's database failed; nothing changed"
  chmod 600 "$backup_dir"/*
  find "$dir/backups" -mindepth 1 -maxdepth 1 -type d | sort | head -n -3 | xargs -r rm -rf
}

# upgrade VERSION hands the upgrade to that version's own script.
upgrade() {
  local to="${1:-}" from next
  [[ "$to" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$ ]] || die "usage: ace upgrade <version>, e.g. ace upgrade 2.0.1"
  from="$(setting ACE_VERSION)"
  [[ "$to" != "$from" ]] || die "the panel already runs ${to}"
  (($(major "$to") >= first_major)) ||
    die "this panel runs ${from}; it cannot go back to ${to}, a 1.x version (v2 has its own data). ace rollback goes back to the version before the last upgrade"
  next="$(mktemp)"
  if ! fetch "$to" ace "$next"; then
    rm -f "$next"
    die "no version ${to} in ace-install: https://github.com/Kup1ng/ace-install/tags"
  fi
  exec bash "$next" __upgrade "$to" "$next"
}

# do_upgrade VERSION SELF runs in the target version's script: it gets the
# files and images first, backs up, switches, and goes back on failure. It
# refuses a 1.x panel: v2 starts on a fresh install (D52.2).
do_upgrade() {
  local to="$1" from
  # Not local: the EXIT trap runs after this function returns.
  self="$2"
  new="$(mktemp -d)"
  trap 'rm -rf "$new" "$self"' EXIT
  from="$(setting ACE_VERSION)"
  if (($(major "${from:-0}") < first_major)); then
    die "this panel runs ${from:-an unknown version}, and ${to} starts on a fresh install: nothing carries over from 1.x (v2 has no MySQL and a new database). Install ${to} on a fresh server (install.sh), or stay on the 1.x line (ace upgrade 1.x.y); nothing changed"
  fi
  fetch "$to" compose.yml "$new/compose.yml" || die "cannot download the stack of ${to}; nothing changed"
  render_caddyfile "$new/Caddyfile" # this version's Caddyfile, from the same .env
  say "Pulling the images of ${to}"
  ACE_VERSION="$to" docker compose --env-file "$dir/.env" -f "$new/compose.yml" pull </dev/null ||
    die "cannot pull the images of ${to}; nothing changed"
  backup "$from" "$to"

  # What runs now, for a rollback by hand or by this script.
  rm -rf "$dir/rollback"
  install -d -m 700 "$dir/rollback"
  cp -p "$dir/compose.yml" "$dir/.env" "$dir/rollback/"
  [[ ! -f "$dir/Caddyfile" ]] || cp -p "$dir/Caddyfile" "$dir/rollback/"
  cp -p /usr/local/bin/ace "$dir/rollback/ace"

  say "Moving the panel from ${from} to ${to}"
  cp "$new/compose.yml" "$dir/compose.yml"
  install -m 644 "$new/Caddyfile" "$dir/Caddyfile"
  set_setting ACE_VERSION "$to"
  if start && healthy "$to"; then
    install -m 755 "$self" /usr/local/bin/ace
    say "Done: the panel runs ${to}; ace rollback goes back to ${from}"
    return 0
  fi
  warn "the panel ${to} is not healthy within 3 minutes; going back to ${from}"
  restore
  if start && healthy "$from"; then
    rm -rf "$dir/rollback"
    die "the upgrade to ${to} failed, and the panel runs ${from} again; see why with: ace logs panel-api"
  fi
  die "the upgrade failed, and ${from} is not healthy either; the database as it was is in ${backup_dir}"
}

rollback() {
  local from to
  [[ -d "$dir/rollback" ]] || die "nothing to go back to: no upgrade since the install, or it was rolled back already"
  from="$(setting ACE_VERSION)"
  to="$(setting ACE_VERSION "$dir/rollback/.env")"
  say "Going back from ${from} to ${to}; the data stays as it is"
  restore
  start || die "the panel ${to} did not start (see: ace logs)"
  healthy "$to" || die "the panel ${to} is not healthy within 3 minutes (see: ace logs panel-api)"
  install -m 755 "$dir/rollback/ace" /usr/local/bin/ace
  rm -rf "$dir/rollback"
  say "Done: the panel runs ${to} again"
}

main() {
  local cmd="${1:-help}"
  [[ $# -eq 0 ]] || shift
  case "$cmd" in
  help | -h | --help)
    usage
    return 0
    ;;
  __check-cert)
    # install.sh checks an owner's certificate before it changes anything.
    check_cert "$@"
    return 0
    ;;
  esac
  [[ $EUID -eq 0 ]] || die "run as root"
  [[ -f "$dir/compose.yml" ]] || die "the Ace panel is not installed in ${dir}"
  case "$cmd" in
  status)
    compose ps
    printf '\nversion %s at https://%s (HTTPS: %s)\n' "$(setting ACE_VERSION)" "$(setting ACE_DOMAIN)" "$(setting ACE_TLS)"
    ;;
  logs) compose logs --tail=200 -f "$@" ;;
  version) setting ACE_VERSION ;;
  restart)
    compose restart "$@"
    say "restarted ${1:-the panel}"
    ;;
  apply) apply ;;
  certificate) certificate "$@" ;;
  upgrade) upgrade "$@" ;;
  rollback) rollback ;;
  __upgrade) do_upgrade "$@" ;;
  __caddyfile) write_caddyfile ;; # install.sh, once .env is written
  __tls-files) tls_files "$@" ;;  # install.sh, for ACE_TLS=custom
  *)
    usage >&2
    die "unknown command: ${cmd}"
    ;;
  esac
}

main "$@"
